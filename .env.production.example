# =================================================================
# Skool Explorer Production Environment Configuration Template
# Copy to .env.production: cp .env.production.example .env.production
# =================================================================

# ─── PostgreSQL Database Settings ───
POSTGRES_DB=skool
POSTGRES_USER=skool
POSTGRES_PASSWORD=skool_secure_pass_change_in_production
PG_HOST=db
PGHOST=db
PG_PORT=5432
PGPORT=5432
PG_USER=skool
PGUSER=skool
PG_PASSWORD=skool_secure_pass_change_in_production
PGPASSWORD=skool_secure_pass_change_in_production
PG_DATABASE=skool
PGDATABASE=skool

# Combined asyncpg URL for SQLAlchemy harvester & scheduler
DATABASE_URL=postgresql+asyncpg://skool:skool_secure_pass_change_in_production@db:5432/skool

# ─── FastAPI Backend Settings ───
PORT=3001
# Strong secret key for JWT auth (64+ characters)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=skool_production_secret_key_change_me_to_a_random_48_char_string
JWT_SECRET=skool_production_secret_key_change_me_to_a_random_48_char_string
AUTH_TOKEN_DAYS=7
META_CACHE_TTL_S=300
ANALYTICS_CACHE_TTL_S=120
ANALYTICS_CACHE_MAX=50
CORS_ORIGINS=

# ─── Frontend & Proxy Ports ───
HTTP_PORT=80
HTTPS_PORT=443

# ─── Initial Admin Account Seed (Optional) ───
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
